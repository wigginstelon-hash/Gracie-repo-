+import pathlib
+import sys
+import win32com.client
+
+text_file, output_file = sys.argv[1:3]
+text = pathlib.Path(text_file).read_text(encoding='utf-8')
+voice = win32com.client.Dispatch('SAPI.SpVoice')
+stream = win32com.client.Dispatch('SAPI.SpFileStream')
+try:
+    stream.Open(str(pathlib.Path(output_file).resolve()), 3, False)
+    voice.AudioOutputStream = stream
+    voice.Speak(text, 16)  # SVSFIsNotXML: model replies are plain text, never SSML.
+finally:
+    stream.Close()
diff --git a/GracieAi/scripts/local-transcribe.py b/GracieAi/scripts/local-transcribe.py
new file mode 100644
index 0000000..b9b5dfb
--- /dev/null
+++ b/GracieAi/scripts/local-transcribe.py
@@ -0,0 +1,34 @@
+import json
+import os
+import sys
+
+os.environ['HF_HUB_OFFLINE'] = '1'
+os.environ['HF_HUB_DISABLE_TELEMETRY'] = '1'
+from faster_whisper import WhisperModel
+import av
+import numpy as np
+
+model_folder, audio_file = sys.argv[1:3]
+chunks = []
+samples = 0
+resampler = av.AudioResampler(format='s16', layout='mono', rate=16000)
+with av.open(audio_file, mode='r') as container:
+    for frame in container.decode(audio=0):
+        for converted in resampler.resample(frame):
+            samples += converted.samples
+            if samples > 46 * 16000:
+                raise ValueError('Recording exceeds the 45-second limit.')
+            chunks.append(converted.to_ndarray().flatten().astype(np.float32) / 32768.0)
+    for converted in resampler.resample(None):
+        samples += converted.samples
+        if samples > 46 * 16000:
+            raise ValueError('Recording exceeds the 45-second limit.')
+        chunks.append(converted.to_ndarray().flatten().astype(np.float32) / 32768.0)
+audio = np.concatenate(chunks) if chunks else np.empty(0, dtype=np.float32)
+if len(audio) < 1600:
+    print(json.dumps({'text': ''}))
+    sys.exit(0)
+model = WhisperModel(model_folder, device='cpu', compute_type='int8', cpu_threads=4, local_files_only=True)
+segments, info = model.transcribe(audio, language='en', beam_size=3, condition_on_previous_text=False, vad_filter=True)
+text = ' '.join(segment.text.strip() for segment in segments).strip()
+print(json.dumps({'text': text}, ensure_ascii=False))
diff --git a/GracieAi/scripts/package.cjs b/GracieAi/scripts/package.cjs
new file mode 100644
index 0000000..9cf1446
--- /dev/null
+++ b/GracieAi/scripts/package.cjs
@@ -0,0 +1,46 @@
+const fs = require('node:fs/promises');
+const { createWriteStream } = require('node:fs');
+const path = require('node:path');
+const { createHash } = require('node:crypto');
+const { pipeline } = require('node:stream/promises');
+const archiver = require('archiver');
+
+async function main() {
+  const root = path.resolve(__dirname, '..');
+  const filename = 'GracieAi-2026-10-23.zip';
+  const output = path.join(root, '..', filename);
+  const temporary = output + '.tmp';
+  // An explicit content list keeps credentials, user data and dependencies out.
+  const entries = ['.env.example', '.gitattributes', '.gitignore', 'LICENSE', 'README.md',
+    'Start-GracieAi.bat', 'Start-GracieAi-Local.bat', 'Start-GracieAi-Online.bat', 'Setup-Local-Speech.bat', 'dist', 'electron', 'src', 'scripts', 'index.html',
+    'local-models.json', 'package-lock.json', 'package.json', 'tsconfig.json', 'vite.config.ts'];
+  await fs.access(path.join(root, 'dist/index.html'));
+  const archive = archiver('zip', { zlib: { level: 9 } });
+  archive.on('warning', error => archive.destroy(error));
+  const completion = pipeline(archive, createWriteStream(temporary));
+  completion.catch(() => {}); // Register rejection handling while entries are collected.
+  async function append(relative) {
+    const absolute = path.join(root, relative);
+    const info = await fs.lstat(absolute);
+    if (info.isSymbolicLink()) throw Error('Refusing to package symlink: ' + relative);
+    if (info.isDirectory()) {
+      for (const child of (await fs.readdir(absolute)).sort()) await append(path.join(relative, child));
+    } else if (info.isFile()) {
+      archive.file(absolute, { name: 'GracieAi/' + relative.split(path.sep).join('/') });
+    } else throw Error('Unsupported package entry: ' + relative);
+  }
+  try {
+    for (const entry of entries) await append(entry);
+    await Promise.all([archive.finalize(), completion]);
+    await fs.rename(temporary, output);
+    const checksum = createHash('sha256').update(await fs.readFile(output)).digest('hex');
+    await fs.writeFile(output.replace(/\.zip$/, '.sha256'), checksum + '  ' + filename + '\n');
+    console.log('Packaged ' + filename + '\nSHA-256: ' + checksum);
+  } catch (error) {
+    archive.destroy(error);
+    await completion.catch(() => {});
+    await fs.rm(temporary, { force: true });
+    throw error;
+  }
+}
+main().catch(error => { console.error(error); process.exitCode = 1; });
