+ await assert.rejects(client.chat({model:'remote-alias',message:'Hello'}),/not installed/);
+ await assert.rejects(client.library.cloudModels(),/disabled/);assert.throws(()=>client.library.startPull('qwen3:4b'),/Downloads/);
+ assert.equal(chatCalls,0);assert.equal((await client.chat({model:'gracie-assistant:latest',message:'Hello'})).content,'Local answer');assert.equal(chatCalls,1);
