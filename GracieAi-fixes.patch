@@ -25,3 +25,13 @@ The Ollama app launcher opens third-party applications with the selected model.
 ## License
 
 See LICENSE for the license supplied with this project.
+
+Run `npm run package` to build, run every test, and regenerate the ZIP and SHA-256 file in the parent folder. The package script includes an explicit list of source and build files; it excludes installed dependencies and private data.
+
+## Dedicated local Gracie
+
+Double-click Start-GracieAi-Local.bat. Setup checks Ollama and creates gracie-assistant:latest from the already-installed qwen3.5:4b. It reuses those weights with Gracie's identity and modest context settings; it is not training a foundation model. If the base is missing, setup stops and tells you to install it. To create the profile from a different compact installed base, run npm run setup:local -- <exact-model-tag> before first launch. An existing Gracie profile is preserved.
+
+Local assistant mode blocks cloud inference, OpenAI voice, online model discovery/downloads, and automatic web research in the app. Typed chat, local document/image attachments, persistent memory, project helpers and app building use local weights. Explicit browser tasks and trusted project scripts may still access the network; this mode is not a network sandbox. Local microphone recognition and speech playback are not implemented.
+
+Use npm run doctor for connection, model and memory diagnostics. Conversation data stays in data/ next to this copy of the app. Keep that folder when updating; the downloadable ZIP never includes private data. Close Gracie before copying an older data/ folder into a new install, and keep the original as a backup.
diff --git a/GracieAi/Start-GracieAi-Local.bat b/GracieAi/Start-GracieAi-Local.bat
new file mode 100644
index 0000000..29ad79c
--- /dev/null
+++ b/GracieAi/Start-GracieAi-Local.bat
@@ -0,0 +1,29 @@
+@echo off
+cd /d "%~dp0"
+title Gracie - Local assistant
+where node >nul 2>nul
+if errorlevel 1 (
+ echo Install Node.js LTS first.
+ pause
+ exit /b 1
+)
+if not exist "node_modules\" (
+ call npm ci --no-audit --no-fund
+ if errorlevel 1 exit /b 1
+)
+set "GRACIE_LOCAL_ONLY=1"
+set "OLLAMA_MODEL=gracie-assistant:latest"
+set "GRACIE_AUTOSTART_OLLAMA=1"
+set "VITE_DEV_SERVER_URL="
+node scripts\setup-local.cjs
+if errorlevel 1 (
+ echo Local setup failed. Install qwen3.5:4b with Ollama, then try again.
+ pause
+ exit /b 1
+)
+if not exist "dist\index.html" (
+ call npm run build
+ if errorlevel 1 exit /b 1
+)
+call npm start
+pause
diff --git a/GracieAi/electron/local-assistant.cjs b/GracieAi/electron/local-assistant.cjs
new file mode 100644
index 0000000..49e5a53
--- /dev/null
+++ b/GracieAi/electron/local-assistant.cjs
@@ -0,0 +1,26 @@
+const {validTag,isCloudTag}=require('./model-library.cjs');
+const {getProfile}=require('./personalities.cjs');
+
+async function setupLocalAssistant({baseModel='qwen3.5:4b',name='gracie-assistant:latest',url='http://127.0.0.1:11434',fetchImpl=globalThis.fetch,signal}={}) {
+  const address=new URL(url);
+  if(!['http:','https:'].includes(address.protocol)||!['localhost','127.0.0.1','[::1]'].includes(address.hostname)||address.username||address.password)throw Error('Local setup must use Ollama on this computer.');
+  if(!validTag(name)||!validTag(baseModel)||isCloudTag(name)||isCloudTag(baseModel)||name===baseModel)throw Error('Choose separate valid local model names.');
+  async function request(route,body){
+    const response=await fetchImpl(new URL(route,address.origin),{method:body?'POST':'GET',headers:{'Content-Type':'application/json'},...(body?{body:JSON.stringify(body)}:{}),signal:AbortSignal.any([AbortSignal.timeout(60000),...(signal?[signal]:[])])});
+    const data=await response.json();if(!response.ok||data.error)throw Error(data.error||'Ollama setup failed: '+response.status);return data;
+  }
+  signal?.throwIfAborted();
+  const tags=await request('/api/tags');
+  const models=Array.isArray(tags.models)?tags.models:[];
+  const existing=models.find(model=>model.name===name);
+  if(existing){if(existing.remote_host||existing.remote_model)throw Error('The Gracie profile name belongs to a cloud model. Choose another name.');return {created:false,name,existing:true};}
+  const base=models.find(model=>model.name===baseModel);
+  if(!base||base.remote_host||base.remote_model)throw Error('Install the chosen local base model in Ollama before creating Gracie. No model was downloaded.');
+  if(!(base.size>0&&base.size<7*1024**3))throw Error('Choose a compact base model under 7 GiB for this Gracie profile.');
+  signal?.throwIfAborted();
+  await request('/api/create',{model:name,from:baseModel,system:getProfile().prompt,parameters:{num_ctx:4096,num_batch:64,temperature:0.6,repeat_penalty:1},stream:false});
+  const installed=await request('/api/tags');
+  if(!installed.models?.some(model=>model.name===name&&!model.remote_host&&!model.remote_model))throw Error('Ollama did not confirm the local Gracie profile.');
+  return {created:true,name,baseModel};
+}
+module.exports={setupLocalAssistant};
