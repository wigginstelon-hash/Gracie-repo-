+async function fixture(t, run) {
+  const root = await fs.mkdtemp(path.join(os.tmpdir(), 'gracie-speech-test-'));
+  t.after(() => fs.rm(root, { recursive: true, force: true }));
+  for (const file of ['models/speech/venv/Scripts/python.exe', 'models/speech/whisper-tiny.en/model.bin', 'models/speech/whisper-tiny.en/config.json', 'models/speech/whisper-tiny.en/vocabulary.txt']) {
+    await fs.mkdir(path.dirname(path.join(root, file)), { recursive: true }); await fs.writeFile(path.join(root, file), 'fixture');
+  }
+  const calls = [];
+  const voice = createLocalSpeech({ appRoot: root, dataDir: path.join(root, 'data'), platform: 'win32', spawnImpl(command, args, options) {
+    const child = new EventEmitter(); child.stdout = new PassThrough(); child.stderr = new PassThrough();
+    child.kill = () => { setImmediate(() => child.emit('close', 1)); return true; };
+    calls.push({ command, args, options, child });
+    setImmediate(async () => { try { await run?.(calls.at(-1)); } catch (error) { child.emit('error', error); } });
+    return child;
+  } });
+  return { voice, calls, root };
+}
+
+test('local speech rejects unsupported formats, invalid/oversized audio and oversized text before launching a process', async t => {
