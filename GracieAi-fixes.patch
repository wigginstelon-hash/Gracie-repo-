+  await assert.rejects(voice.transcribe({ mimeType: 'audio/wav', audio: '../bad' }), /invalid/);
+  await assert.rejects(voice.transcribe({ mimeType: 'audio/wav', audio: 'A'.repeat(12 * 1024 * 1024 + 1) }), /large/);
+  await assert.rejects(voice.synthesize({ text: 'a'.repeat(4001) }), /4,000/);
+  assert.equal(calls.length, 0);
+});
+
+test('transcription uses local files, offline workers and cleans its temporary recording', async t => {
+  const { voice, calls, root } = await fixture(t, async ({ args, child }) => {
+    assert.equal((await fs.readFile(args[2])).toString(), 'recorded audio');
+    child.stdout.end(JSON.stringify({ text: '  verification forty two  ' })); child.emit('close', 0);
+  });
+  assert.deepEqual(await voice.transcribe({ mimeType: 'audio/webm;codecs=opus', audio: Buffer.from('recorded audio').toString('base64') }), { text: 'verification forty two' });
+  assert.equal(calls[0].options.env.HF_HUB_OFFLINE, '1');
+  assert.equal(calls[0].options.shell, undefined);
+  assert.equal(calls[0].options.windowsHide, true);
