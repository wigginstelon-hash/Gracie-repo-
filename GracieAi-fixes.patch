+ assert.equal((await setupLocalAssistant({fetchImpl})).created,false);assert.equal(posts,0);
+ await assert.rejects(setupLocalAssistant({url:'https://example.com',fetchImpl}),/this computer/);
+ await assert.rejects(setupLocalAssistant({baseModel:'foo:cloud',fetchImpl}),/local model names/);
+ await assert.rejects(setupLocalAssistant({fetchImpl:async()=>reply({models:[]})}),/No model was downloaded/);
+ await assert.rejects(setupLocalAssistant({fetchImpl:async()=>reply({models:[{name:'qwen3.5:4b',size:18e9}]})}),/compact/);
+});
