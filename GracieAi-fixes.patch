+
+test('unrequested application calls are rejected before dispatch even if a project is selected',async()=>{
+ let dispatched=0;const localTools={specs:require('./local-tools.cjs').specs,projectStatus:()=>({folder:'selected'}),execute:async()=>{dispatched++;return {ok:true};}};
+ const client=createOllamaClient({env:{},resourceCheck:async()=>{},localTools,fetchImpl:async url=>{
