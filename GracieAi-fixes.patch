+ const client=createOllamaClient({env:{},fetchImpl:async()=>reply({models:[{name:'qwen3.5:9b'},{name:'qwen3.5:4b'},{name:'gracie-local:latest'}]})});
+ assert.equal((await client.status()).defaultModel,'qwen3.5:4b');
